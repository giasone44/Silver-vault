# --- AI ------------------------------------------------------------------
# Free by default: photos are read by a local model through Ollama (ollama.com).
OLLAMA_MODEL=qwen2.5vl:3b
# OLLAMA_URL=http://127.0.0.1:11434
# Optional, paid: set an Anthropic key to use Claude instead (better reading
# plus web research of sold prices).
# ANTHROPIC_API_KEY=

# Free Numista catalogue key (numista.com/api) - exact specs and price guides.
NUMISTA_API_KEY=

# Required: shared secret the app sends with every request. Pick a long random string
# and enter the same value in the app's Settings screen.
APP_TOKEN=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------
PORT=8787
# Where the database and photos are stored.
DATA_DIR=./data

# Claude model used for identification and valuation.
CLAUDE_MODEL=claude-opus-5-5

# Spot price provider: "gold-api" (free, no key), "metals-dev", or "goldapi-io".
SPOT_PROVIDER=gold-api
SPOT_API_KEY=
# How long (seconds) a spot quote is cached before re-fetching.
SPOT_TTL_SECONDS=30

# eBay developer app credentials (developer.ebay.com). When set, current
# eBay listings are pulled in as extra comparables. Actual *sold* data needs
# eBay to approve your app for the Marketplace Insights API; set
# EBAY_MARKETPLACE_INSIGHTS=true once approved.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_INSIGHTS=false
